# Copy to .env on the server (do not commit .env).
# Local listen port and UI port are in src/main/resources/ports.properties.
# APP_FRONTEND_URL below replaces the local http://localhost:<app.frontend.port> default.
# Export these into the process environment (Spring does not auto-load .env files).
# For Stripe on pre-prod you can also use gitignored config/application-preprod.properties
# (see config/application-preprod.properties.example).

# Mail
MAIL_USERNAME=noreply@socialpairly.com
MAIL_PASSWORD=
APP_SUPPORT_EMAIL=customercare@socialpairly.com

# Public site URL (Stripe redirects / email links) — IP or domain
APP_FRONTEND_URL=http://3.151.77.90
APP_EMAIL_BASE_URL=https://www.socialpairly.com

# Stripe (required when app.preprod-flag=true; empty classpath defaults on purpose)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional extra CORS origins (comma-separated)
# APP_SECURITY_CORS_ADDITIONAL_ORIGINS=https://staging.socialpairly.com
